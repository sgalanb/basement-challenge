{
  "name": "basement-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "sanity:typegen": "sanity schema extract --force --enforce-required-fields --path src/sanity/schema.json && sanity typegen generate",
    "typecheck": "pnpm sanity:typegen && next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.6.1",
    "@sanity/code-input": "^7.3.8",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.13.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "geist": "^1.7.2",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.13.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
